{
  "name": "@coder/mux-chat-components",
  "version": "0.1.0",
  "description": "Shared chat components for Xum conversation rendering",
  "packageManager": "bun@1.3.5",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": {
      "default": "./styles/variables.css"
    }
  },
  "files": [
    "dist",
    "styles/variables.css"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coder/xum.git",
    "directory": "packages/chat-components"
  },
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public"
  }
}
