{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "noEmit": true,
    "types": ["react", "bun"],
    "moduleSuffixes": [".native", ""],
    "paths": {
      "@/*": ["../../src/*"],
      "@shared/*": ["../../src/*"]
    }
  },
  "include": [
    "App.tsx",
    "index.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
